.venv/
.uv-cache/
.pytest_cache/
.pytest-cache/
.pytest-tmp/
.ruff_cache/
__pycache__/
*.py[cod]
*.egg-info/
.claude/worktrees/
# Machine-local agent configuration. The Spec Kit installer warns that agent
# folders may hold credentials or auth tokens.
.claude/settings.local.json
.claude/skills/

# GitHub Spec Kit scaffold, installed per-machine with `specify init --here`.
# Deliberately untracked: its vendored PowerShell helpers carry cyclomatic
# complexity far above this repository's CodeScene thresholds (common.ps1's
# Resolve-TemplateContent is 52 against a threshold of 9), and AGENTS.md
# requires every new file to score 10.00. Vendoring third-party tooling into
# that gate would either fail the gate or force an exclusion that weakens it
# for everything else. The CLI is reinstallable and carries its own templates,
# so nothing here is a project artifact.
.specify/
tests/.pytest_tmp*/
dist/
build/
cdk.out/
*.cdk.staging/

# Workbooks written by a local report run. Customer content by construction, so
# it must never reach a commit -- see docker-compose.local.yml.
.local-workbooks/

# Subagent-driven development scratch
.superpowers/

# Local staging TLS material. Generated by `ops/staging/generate-certs.sh`, never
# shared: a committed private key is a committed private key regardless of what it
# protects, and these are meant to be regenerated per machine.
ops/staging/certs/

# Compose interpolates from a project `.env` automatically while
# `khepri.local.config` reads `os.environ` only, so a credential written there
# would configure MinIO and never reach a `uv run` client. Export the variables
# instead; this keeps a committed `.env` from splitting the two runtimes for
# everyone at once.
.env

# The Impeccable design hook's per-session state: absolute machine paths and
# session UUIDs, meaningless in another checkout. `config.json` beside it is the
# durable half -- the adjudicated rule suppressions -- and is committed.
.impeccable/hook.cache.json
