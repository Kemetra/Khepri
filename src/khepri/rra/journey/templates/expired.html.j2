{% extends "base.html.j2" %}
{% block title %}{{ copy.expired_title }} · {{ copy.product }}{% endblock %}
{% block content %}
<section class="journey-document" aria-labelledby="page-title">
  {% if request.query_params.get("deletion") == "requested" %}
  <h1 id="page-title">{{ copy.deletion_requested_title }}</h1>
  <p class="lede">{{ copy.deletion_requested_intro }}</p>
  {% else %}
  <h1 id="page-title">{{ copy.expired_title }}</h1>
  <p class="lede">{{ copy.expired_intro }}</p>
  {% endif %}
  {#
    Outside the branch, deliberately. This surface may say two different things about what happened,
    but the way out must not depend on which -- `FR-050` forbids distinguishing the collapsed causes
    "by copy, status code, page identity, or navigation state", and an exit that differed by branch
    would be exactly that. Same string, same target, same presence as the shell's `unavailable`.
  #}
  <p><a href="/app/{{ language }}">{{ copy.recovery_exit }}</a></p>
</section>
{% endblock %}
