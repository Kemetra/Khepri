{% extends "base.html.j2" %}
{% block title %}{{ copy.review_title }} · {{ copy.product }}{% endblock %}
{% block content %}
<section class="journey-document journey-document--wide" aria-labelledby="page-title">
  <h1 id="page-title">{{ copy.review_title }}</h1><p class="lede">{{ copy.review_intro }}</p>
  {#
    Both languages of the refusal wording travel on the page, like the value
    vocabulary below, so `review.js` renders a governed refusal without carrying
    a word of either language. The server's own stated reason is shown alongside
    when it gives one: it names which version pairing was refused, and that is
    the part a generic message destroys.
  #}
  <div id="error-summary" class="error-summary" role="alert" tabindex="-1" hidden
    data-refusal-title="{{ copy.refusal_title }}"
    data-refusal-stated="{{ copy.refusal_stated }}"
    data-review-unavailable="{{ copy.review_unavailable }}"
    data-analysis-unavailable="{{ copy.analysis_unavailable }}"></div>
  <div id="profile-findings" class="refusal-summary" role="status" hidden
    data-title="{{ copy.review_blocked_title }}"
    data-generic="{{ copy.reason_generic }}"
    data-no-data-rows="{{ copy.reason_no_data_rows }}"
    data-no-admissible-time-field="{{ copy.reason_no_time_field }}"
    data-no-answerable-core-measure="{{ copy.reason_no_core_measure }}"
    data-irreconcilable-types="{{ copy.reason_irreconcilable_types }}"
    data-unresolved-ambiguous-mapping="{{ copy.reason_ambiguous_mapping }}"
    data-missing-requested-semantic="{{ copy.reason_missing_semantic }}"
    data-duplicate-safe-labels="{{ copy.finding_duplicate_labels }}"
    data-all-columns-empty="{{ copy.finding_all_columns_empty }}"></div>
  <div id="value-vocabulary" hidden
    data-semantic-transaction-date="{{ copy.semantic_transaction_date }}"
    data-semantic-revenue="{{ copy.semantic_revenue }}"
    data-semantic-units="{{ copy.semantic_units }}"
    data-semantic-transaction-id="{{ copy.semantic_transaction_id }}"
    data-semantic-product="{{ copy.semantic_product }}"
    data-semantic-category="{{ copy.semantic_category }}"
    data-semantic-store="{{ copy.semantic_store }}"
    data-semantic-channel="{{ copy.semantic_channel }}"
    data-semantic-cost="{{ copy.semantic_cost }}"
    data-semantic-discount="{{ copy.semantic_discount }}"
    data-semantic-returns="{{ copy.semantic_returns }}"
    data-state-mapped="{{ copy.state_mapped }}"
    data-state-ambiguous="{{ copy.state_ambiguous }}"
    data-state-conflicting="{{ copy.state_conflicting }}"
    data-state-unavailable="{{ copy.state_unavailable }}"></div>
  <div class="table-region" role="region" aria-labelledby="mapping-caption" tabindex="0">
    <table id="mapping-table"><caption id="mapping-caption">{{ copy.review_title }}</caption>
      <thead><tr><th scope="col">{{ copy.column }}</th><th scope="col">{{ copy.retail_meaning }}</th><th scope="col">{{ copy.status }}</th><th scope="col">{{ copy.evidence }}</th></tr></thead>
      <tbody></tbody>
    </table>
  </div>
  <div class="actions"><button id="confirm-mapping" class="primary-button" disabled>{{ copy.confirm }}</button><button id="restart" class="text-button">{{ copy.restart }}</button></div>
</section>
{% endblock %}
{% block script %}<script type="module" src="/beta/assets/review.js"></script>{% endblock %}
