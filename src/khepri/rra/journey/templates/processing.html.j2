{% extends "base.html.j2" %}
{% block title %}{{ copy.processing_title }} · {{ copy.product }}{% endblock %}
{% block content %}
<section class="document-card" aria-labelledby="page-title">
  <h1 id="page-title">{{ copy.processing_title }}</h1><p class="lede">{{ copy.processing_intro }}</p>
  <div class="indeterminate" role="progressbar" aria-label="Report generation in progress"><span></span></div>
  <ol id="durable-stages" class="stages"><li>Upload and review</li><li>Confirmed facts</li><li>Report generation</li><li>Complete publication</li></ol>
  <p id="processing-status" aria-live="polite"></p>
</section>
{% endblock %}
{% block script %}<script type="module" src="/beta/assets/processing.js"></script>{% endblock %}
