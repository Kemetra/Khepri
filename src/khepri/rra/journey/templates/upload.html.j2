{% extends "base.html.j2" %}
{% block title %}{{ copy.upload_title }} · {{ copy.product }}{% endblock %}
{% block content %}
<section class="journey-document" aria-labelledby="page-title">
  <h1 id="page-title">{{ copy.upload_title }}</h1>
  <p class="lede">{{ copy.upload_intro }}</p>
  <dl class="intake-facts">
    <div><dt>{{ copy.accepted }}</dt><dd>CSV, XLSX</dd></div>
    <div><dt>{{ copy.size_limit }}</dt><dd dir="ltr">50 MB</dd></div>
    <div><dt>{{ copy.you_receive }}</dt><dd>{{ copy.outputs }}</dd></div>
  </dl>
  <div id="error-summary" class="error-summary" role="alert" tabindex="-1" hidden data-invitation="{{ copy.invitation_unavailable }}" data-temporary="{{ copy.temporary_unavailable }}" data-profile-rejected="{{ copy.profile_rejected }}" data-file-invalid="{{ copy.file_invalid }}" data-upload-failed="{{ copy.upload_failed }}"></div>
  <form id="upload-form">
    <label class="consent-row"><input id="consent" type="checkbox"> <span>{{ copy.consent }}</span></label>
    <label id="drop-zone" class="drop-zone" for="sales-file" aria-describedby="file-help">
      <svg class="drop-icon" aria-hidden="true" viewBox="0 0 24 24" width="32" height="32"><path d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5M5 14v5h14v-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <strong>{{ copy.drop_file }}</strong>
      <span class="button-like">{{ copy.choose_file }}</span>
    </label>
    <input id="sales-file" class="visually-hidden" type="file" accept=".csv,.xlsx,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" disabled>
    <p id="file-help" class="meta">CSV · XLSX · 50 MB</p>
    {#
      The source contract, declared by the operator. `RRA-003` holds that generic
      headers and observed values never establish event kind, status, currency,
      basis, or identity, so none of these is inferred from the file and none is
      defaulted in the client: each is a control the operator sets and can see.

      Every control is a native input with a `for`/`id` label pair, so it is
      focusable and operable from the keyboard alone. `data-contract-field`
      carries the wire name, which is what lets `upload.js` build the request
      body from the form instead of restating the field list a second time.
    #}
    <fieldset id="source-contract" class="contract-fieldset">
      <legend>{{ copy.contract_legend }}</legend>
      <p class="meta">{{ copy.contract_intro }}</p>
      <p class="contract-row">
        <label for="contract-contract-id">{{ copy.contract_id }}</label>
        <input id="contract-contract-id" data-contract-field="contract_id" data-contract-required type="text" required>
      </p>
      <p class="contract-row">
        <label for="contract-evidence">{{ copy.contract_evidence }}</label>
        <input id="contract-evidence" data-contract-field="evidence" data-contract-required type="text" required>
      </p>
      <p class="contract-row">
        <label for="contract-currency-code">{{ copy.contract_currency_code }}</label>
        {#
          `pattern` plus an uppercasing `text-transform` because a lowercase
          `egp` is refused ("A declared currency must be one uppercase ISO 4217
          code") and, on the resume path, that costs the session rather than the
          field. The constraint is declared on the control so the browser blocks
          submission before the request is made.

          The native validation bubble is not the only signal: `aria-describedby`
          ties a persistent visible hint to the input, so the rule is readable
          before the mistake and by a screen reader, not just after it.
        #}
        <input id="contract-currency-code" data-contract-field="currency_code" type="text" dir="ltr" maxlength="3" size="3" pattern="[A-Za-z]{3}" inputmode="latin" autocapitalize="characters" spellcheck="false" aria-describedby="contract-currency-hint" required>
        <span id="contract-currency-hint" class="meta">{{ copy.contract_currency_hint }}</span>
      </p>
      <p class="contract-row">
        <label for="contract-transaction-id-column">{{ copy.contract_transaction_id_column }}</label>
        <input id="contract-transaction-id-column" data-contract-field="transaction_id_column" type="text">
      </p>
      {#
        Checkboxes rather than a defaulted boolean: `SourceContractBody` would
        accept an omitted flag and supply a value, and that value would be
        indistinguishable downstream from one the operator chose. An unticked
        box is the operator declining the claim, which is a declaration; an
        absent field is an inference.
      #}
      {% for field, label in [
        ("sale_only", copy.contract_sale_only),
        ("posted_only", copy.contract_posted_only),
        ("unique_line_grain_attested", copy.contract_unique_line_grain_attested),
        ("transaction_id_unique_package_wide", copy.contract_transaction_id_unique_package_wide),
        ("revenue_vat_exclusive", copy.contract_revenue_vat_exclusive),
        ("revenue_is_net_of_returns", copy.contract_revenue_is_net_of_returns),
        ("units_are_integral", copy.contract_units_are_integral),
        ("cost_is_extended", copy.contract_cost_is_extended),
        ("discount_is_additive", copy.contract_discount_is_additive),
      ] %}
      <p class="contract-row contract-row--claim">
        <input id="contract-{{ field | replace('_', '-') }}" data-contract-field="{{ field }}" type="checkbox">
        <label for="contract-{{ field | replace('_', '-') }}">{{ label }}</label>
      </p>
      {% endfor %}
    </fieldset>
    {#
      The coverage attestation, and the reason it is optional rather than
      required. `RRA-003` holds that "a date spine, observed minimum or maximum
      date, equal row or day counts, and absence of events never synthesize
      coverage proof", so this cannot be derived from the file and is not
      defaulted here either. Without it the assessment still runs and only
      completeness-dependent comparison and growth refuse, which is why an
      operator who cannot attest is not blocked from uploading.

      `data-manifest-field` carries the wire name, as `data-contract-field`
      does above, so `upload.js` builds the object from the form rather than
      restating the field list. Nothing here is marked required: the manifest
      is omitted entirely when the operator leaves it blank, and a partly
      filled one is refused by `build_coverage_manifest` with a stated reason
      rather than being silently completed.
    #}
    <fieldset id="coverage-manifest" class="contract-fieldset">
      <legend>{{ copy.manifest_legend }}</legend>
      <p class="meta">{{ copy.manifest_intro }}</p>
      <p class="contract-row">
        <label for="manifest-timezone">{{ copy.manifest_timezone }}</label>
        <input id="manifest-timezone" data-manifest-field="timezone" type="text" dir="ltr" spellcheck="false" aria-describedby="manifest-timezone-hint">
        <span id="manifest-timezone-hint" class="meta">{{ copy.manifest_timezone_hint }}</span>
      </p>
      <p class="contract-row">
        <label for="manifest-covered-start">{{ copy.manifest_covered_start }}</label>
        <input id="manifest-covered-start" data-manifest-field="covered_start" type="date">
      </p>
      <p class="contract-row">
        <label for="manifest-covered-end">{{ copy.manifest_covered_end }}</label>
        <input id="manifest-covered-end" data-manifest-field="covered_end" type="date">
      </p>
      <p class="contract-row">
        <label for="manifest-aggregate-scope">{{ copy.manifest_aggregate_scope }}</label>
        <input id="manifest-aggregate-scope" data-manifest-field="aggregate_scope" type="text">
      </p>
      <p class="contract-row">
        <label for="manifest-covered-days">{{ copy.manifest_covered_days }}</label>
        <input id="manifest-covered-days" data-manifest-field="covered_days" data-manifest-list type="text" dir="ltr" spellcheck="false" aria-describedby="manifest-covered-days-hint">
        <span id="manifest-covered-days-hint" class="meta">{{ copy.manifest_covered_days_hint }}</span>
      </p>
      <p class="contract-row">
        <label for="manifest-event-kinds">{{ copy.manifest_event_kinds }}</label>
        <input id="manifest-event-kinds" data-manifest-field="event_kinds" data-manifest-list type="text" spellcheck="false" aria-describedby="manifest-event-kinds-hint">
        <span id="manifest-event-kinds-hint" class="meta">{{ copy.manifest_event_kinds_hint }}</span>
      </p>
      <p class="contract-row">
        <label for="manifest-statuses">{{ copy.manifest_statuses }}</label>
        <input id="manifest-statuses" data-manifest-field="statuses" data-manifest-list type="text" spellcheck="false" aria-describedby="manifest-statuses-hint">
        <span id="manifest-statuses-hint" class="meta">{{ copy.manifest_statuses_hint }}</span>
      </p>
    </fieldset>
    <div id="selected-file" class="selected-file" aria-live="polite"></div>
    <div id="upload-progress" class="progress-wrap" hidden>
      <div class="progress-track" role="progressbar" aria-label="{{ copy.upload_progress }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span></span></div>
    </div>
    <button id="start-assessment" class="primary-button" type="submit" disabled>{{ copy.start }}</button>
    <button id="upload-recovery" class="text-button" type="button" hidden>{{ copy.delete }}</button>
  </form>
</section>
{% endblock %}
{% block script %}<script type="module" src="/beta/assets/upload.js"></script>{% endblock %}
