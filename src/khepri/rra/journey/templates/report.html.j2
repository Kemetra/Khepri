{% extends "base.html.j2" %}
{% block title %}{{ copy.report_title }} · {{ copy.product }}{% endblock %}
{% block content %}
<section class="journey-document journey-document--wide" aria-labelledby="page-title">
  <h1 id="page-title">{{ copy.report_title }}</h1><p class="lede">{{ copy.report_intro }}</p>
  <div id="error-summary" class="error-summary" role="alert" data-temporary="{{ copy.temporary_unavailable }}" hidden></div>
  <dl class="report-meta"><div><dt>{{ copy.dataset }}</dt><dd>{{ copy.uploaded_dataset }}</dd></div><div><dt>{{ copy.rows }}</dt><dd id="row-count" dir="ltr">—</dd></div><div><dt>{{ copy.generated }}</dt><dd id="generated-at" dir="ltr">—</dd></div><div><dt>{{ copy.available_until }}</dt><dd id="expires-at" dir="ltr">—</dd></div></dl>
  {#
    `R8-10`'s journey half, under `RRA-010`: seven links in two labelled groups -- pages
    to open first, files to download second -- so a reader knows the web report is
    where to look before downloading. The headings are this page's copy, present
    before any state loads; `report.js` only files each link into its grid.
  #}
  <div id="report-links" class="report-groups" hidden data-web-en="{{ copy.artifact_web_en }}" data-web-ar="{{ copy.artifact_web_ar }}" data-evidence-en="{{ copy.artifact_evidence_en }}" data-evidence-ar="{{ copy.artifact_evidence_ar }}" data-pdf-en="{{ copy.artifact_pdf_en }}" data-pdf-ar="{{ copy.artifact_pdf_ar }}" data-excel="{{ copy.artifact_excel }}">
    <section class="report-group" aria-labelledby="open-heading"><h2 id="open-heading">{{ copy.open_online }}</h2><div class="report-grid" data-group="open"></div></section>
    <section class="report-group" aria-labelledby="download-heading"><h2 id="download-heading">{{ copy.downloads }}</h2><div class="report-grid" data-group="download"></div></section>
  </div>
  <button id="delete-content" class="text-button">{{ copy.delete }}</button>
</section>
{% endblock %}
{% block script %}<script type="module" src="/beta/assets/report.js"></script>{% endblock %}
