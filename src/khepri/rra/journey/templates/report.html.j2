{% extends "base.html.j2" %}
{% block title %}{{ copy.report_title }} · {{ copy.product }}{% endblock %}
{% block content %}
<section class="document-card wide" aria-labelledby="page-title">
  <h1 id="page-title">{{ copy.report_title }}</h1><p class="lede">{{ copy.report_intro }}</p>
  <div id="error-summary" class="error-summary" role="alert" data-temporary="{{ copy.temporary_unavailable }}" hidden></div>
  <dl class="report-meta"><div><dt>{{ copy.dataset }}</dt><dd>{{ copy.uploaded_dataset }}</dd></div><div><dt>{{ copy.rows }}</dt><dd id="row-count" dir="ltr">—</dd></div><div><dt>{{ copy.generated }}</dt><dd id="generated-at" dir="ltr">—</dd></div></dl>
  <div id="report-links" class="report-grid" hidden data-web-en="{{ copy.artifact_web_en }}" data-web-ar="{{ copy.artifact_web_ar }}" data-evidence-en="{{ copy.artifact_evidence_en }}" data-evidence-ar="{{ copy.artifact_evidence_ar }}" data-pdf-en="{{ copy.artifact_pdf_en }}" data-pdf-ar="{{ copy.artifact_pdf_ar }}" data-excel="{{ copy.artifact_excel }}"></div>
  <button id="delete-content" class="text-button">{{ copy.delete }}</button>
</section>
{% endblock %}
{% block script %}<script type="module" src="/beta/assets/report.js"></script>{% endblock %}
