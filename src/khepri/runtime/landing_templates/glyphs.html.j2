    <symbol id="g-caveated" viewBox="0 0 24 24">
      <path d="M2 8 C4.6 5.4 6.9 5.4 9.5 8 C12.1 10.6 14.4 10.6 17 8 C19.6 5.4 21.4 5.4 22 6.2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
