<!doctype html>
<html lang="{{ language }}" dir="{{ direction }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ copy.product }} — {{ copy.tagline }}</title>
  <meta name="description" content="{{ copy.claim_lede }}">
  <link rel="stylesheet" href="{{ assets }}/landing.css">
  <link rel="alternate" hreflang="{{ alternate }}" href="{{ alternate_href }}">
</head>
<body>
{% include "glyphs.html.j2" %}
<a class="skip-link" href="#main">{{ copy.skip }}</a>

<header class="site-header">
  <span class="brand"><span class="brand-sun" aria-hidden="true"></span>{{ copy.product }}</span>
  <nav class="header-actions" aria-label="{{ copy.language_navigation }}">
    <a class="language-link"
       href="{{ alternate_href }}"
       lang="{{ copy.language_code }}"
       hreflang="{{ copy.language_code }}"
       dir="auto">{{ copy.language }}</a>
  </nav>
</header>

<main id="main">

  {# ══ REGISTER I — arrival. The claim, and beside it the specimen that proves it.
       Two columns on a wide viewport: the claim holds one side, the shrine the other, and the
       band fills the width rather than leaving the wall bare either side of a narrow column.
       DOM order puts the claim first and the grid resolves the sides, so RTL inverts the whole
       composition without a single physical property. ═══════════════════════════════════════ #}
  <section class="register register--claim" aria-labelledby="claim-title">
    <div class="wall hero">

      <div class="hero-claim">
        <h1 id="claim-title">
          {%- set parts = copy.tagline.split(copy.claim_prove) -%}
          {{ parts[0] }}<span class="claim-mark">{{ copy.claim_prove }}</span>{{ parts[1] if parts|length > 1 else "" }}
        </h1>

        <p class="claim-lede">{{ copy.claim_lede }}</p>

        <dl class="hero-facts">
          <div class="hero-fact">
            <dt>{{ copy.specimen_population_term }}</dt>
            <dd class="tabular">{{ copy.specimen_population_value }}</dd>
          </div>
          <div class="hero-fact">
            <dt>{{ copy.specimen_coverage_term }}</dt>
            <dd class="tabular">{{ copy.specimen_coverage_value }}</dd>
          </div>
        </dl>
      </div>

      <figure class="shrine" aria-labelledby="specimen-title">
        <div class="shrine-lintel" aria-hidden="true">
          <svg class="glyph glyph--lintel" aria-hidden="true" focusable="false"><use href="#g-winged-sun"/></svg>
        </div>
        <svg class="glyph glyph--jamb glyph--jamb-start" aria-hidden="true"><use href="#g-capital"/></svg>
        <svg class="glyph glyph--jamb glyph--jamb-end" aria-hidden="true"><use href="#g-capital"/></svg>
        <div class="specimen">
        <div class="specimen-head">
          <span class="specimen-file" id="specimen-title" dir="auto">{{ copy.specimen_file }}</span>
          <span class="state-mark state-mark--admitted">{{ copy.specimen_admitted }}</span>
        </div>

        <div class="specimen-meta">
          <span class="tabular">{{ copy.specimen_meta }}</span>
          <span class="tabular">{{ copy.specimen_period }}</span>
        </div>

        {# A real table, because this is real tabular data: three columns, one row per measure.
           The standing is a column rather than a badge — a figure and its standing are one
           thing. Every state cell names its state in words; the glyph beside it repeats that
           name and never carries it alone. #}
        <table class="ledger">
          <thead>
            <tr>
              <th scope="col">{{ copy.specimen_col_metric }}</th>
              <th scope="col" class="ledger-value">{{ copy.specimen_col_value }}</th>
              <th scope="col">{{ copy.specimen_col_state }}</th>
            </tr>
          </thead>
          <tbody>
            {% for course in courses %}
            <tr class="ledger-row ledger-row--{{ course.state }}">
              <th scope="row">{{ course.term }}</th>
              <td class="ledger-value tabular">{{ course.value }}</td>
              <td class="ledger-state">
                {% if course.state == "proven" %}
                <svg class="glyph glyph--cell" aria-hidden="true"><use href="#g-proven"/></svg>{{ copy.verdict_proven_name }}
                {% else %}
                <svg class="glyph glyph--cell" aria-hidden="true"><use href="#g-caveated"/></svg>{{ copy.verdict_caveated_name }}
                {% endif %}
              </td>
            </tr>
            {% endfor %}

            {# The withheld row, set into the ledger where the figure would have stood. The value
               cell holds an em dash — the place is kept, and left deliberately unfilled. #}
            <tr class="ledger-row ledger-row--withheld">
              <th scope="row">{{ copy.specimen_withheld_term }}</th>
              <td class="ledger-value tabular" aria-hidden="true">—</td>
              <td class="ledger-state">
                <svg class="glyph glyph--cell" aria-hidden="true"><use href="#g-withheld"/></svg>{{ copy.verdict_withheld_name }}
              </td>
            </tr>
          </tbody>
        </table>

        {# The governed texts the ledger's two non-proven rows carry, in the product's own
           wording rather than a paraphrase of it. #}
        <p class="ledger-note ledger-note--caveat">{{ row_caveat }}</p>
        <p class="ledger-note ledger-note--refusal">{{ refusal }}</p>

        <figcaption class="synthetic-note">{{ copy.specimen_caption }}</figcaption>
        </div>
      </figure>

    </div>
  </section>

  {# ══ REGISTERS II–IV — the passage of one file through admission ═════════════════════════ #}
  <section class="register register--deep" aria-labelledby="passage-title">
    <div class="wall">
      <h2 class="register-mark" id="passage-title">
        <span>{{ copy.register_ii }}</span>
        <span class="register-subject" dir="auto">{{ copy.specimen_file }}</span>
      </h2>

      <ol class="passage">
        <li class="passage-step">
          <svg class="glyph glyph--passage" aria-hidden="true"><use href="#g-export"/></svg>
          <span class="passage-index" aria-hidden="true">01</span>
          <span class="passage-term">{{ copy.passage_1_term }}</span>
          <span class="passage-detail">{{ copy.passage_1_detail }}</span>
          <span class="passage-state tabular">{{ copy.passage_1_state }}</span>
        </li>
        <li class="passage-step">
          <svg class="glyph glyph--passage" aria-hidden="true"><use href="#g-scales"/></svg>
          <span class="passage-index" aria-hidden="true">02</span>
          <span class="passage-term">{{ copy.passage_2_term }}</span>
          <span class="passage-detail">{{ copy.passage_2_detail }}</span>
          <span class="passage-state tabular">{{ copy.passage_2_state }}</span>
        </li>
        <li class="passage-step">
          <svg class="glyph glyph--passage" aria-hidden="true"><use href="#g-sun"/></svg>
          <span class="passage-index" aria-hidden="true">03</span>
          <span class="passage-term">{{ copy.passage_3_term }}</span>
          <span class="passage-detail">{{ copy.passage_3_detail }}</span>
        </li>
        <li class="passage-step passage-step--withheld">
          <svg class="glyph glyph--passage" aria-hidden="true"><use href="#g-withheld"/></svg>
          <span class="passage-index" aria-hidden="true">04</span>
          <span class="passage-term">{{ copy.passage_4_term }}</span>
          <span class="passage-detail">{{ copy.passage_4_detail }}</span>
        </li>
        <li class="passage-step">
          <svg class="glyph glyph--passage" aria-hidden="true"><use href="#g-decision"/></svg>
          <span class="passage-index" aria-hidden="true">05</span>
          <span class="passage-term">{{ copy.passage_5_term }}</span>
          <span class="passage-detail">{{ copy.passage_5_detail }}</span>
        </li>
      </ol>

      <p class="passage-figure">
        {{ copy.passage_figure }} <em>{{ copy.passage_figure_em }}</em>
      </p>
    </div>
  </section>

  {# ══ REGISTER V — proof. The three outcomes, named in governed vocabulary. ═══════════════ #}
  <section class="register" aria-labelledby="verdicts-title">
    <div class="wall">
      <h2 class="register-mark" id="verdicts-title"><span>{{ copy.register_v }}</span></h2>

      <div class="contrast">
        <div>
          <span class="contrast-label">{{ copy.contrast_theirs_label }}</span>
          <p class="contrast-quote contrast-quote--theirs">{{ copy.contrast_theirs }}</p>
        </div>
        <div>
          <span class="contrast-label">{{ copy.contrast_ours_label }}</span>
          <p class="contrast-quote contrast-quote--ours">{{ copy.contrast_ours_before }}<span class="claim-mark">{{ copy.claim_prove }}</span>{{ copy.contrast_ours_after }}</p>
        </div>
      </div>

      {# The comparison register. Four axes the rest of this page demonstrates — no axis states a
         capability the specimen and the passage have not already shown. The compared column is a
         category, never a named company. #}
      <table class="compare">
        <caption class="compare-caption">{{ copy.compare_heading }}</caption>
        <thead>
          <tr>
            <th scope="col">{{ copy.compare_axis }}</th>
            <th scope="col" class="compare-ours-head">{{ copy.compare_ours_head }}</th>
            <th scope="col">{{ copy.compare_theirs_head }}</th>
          </tr>
        </thead>
        <tbody>
          {% for row in [
            ("g-proven",   copy.compare_1_axis, copy.compare_1_ours, copy.compare_1_theirs),
            ("g-caveated", copy.compare_2_axis, copy.compare_2_ours, copy.compare_2_theirs),
            ("g-export",   copy.compare_3_axis, copy.compare_3_ours, copy.compare_3_theirs),
            ("g-sun",      copy.compare_4_axis, copy.compare_4_ours, copy.compare_4_theirs),
          ] %}
          <tr>
            <th scope="row">{{ row[1] }}</th>
            <td class="compare-ours">
              <svg class="glyph glyph--cell" aria-hidden="true"><use href="#{{ row[0] }}"/></svg>{{ row[2] }}
            </td>
            <td class="compare-theirs">{{ row[3] }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>

      <div class="verdicts">
        <article class="verdict verdict--proven">
          <span class="verdict-name"><svg class="glyph glyph--state" aria-hidden="true"><use href="#g-proven"/></svg>{{ copy.verdict_proven_name }}</span>
          <p class="verdict-claim">{{ copy.verdict_proven_claim }}</p>
          <p class="verdict-detail">{{ copy.verdict_proven_detail }}</p>
        </article>

        <article class="verdict verdict--caveated">
          <span class="verdict-name"><svg class="glyph glyph--state" aria-hidden="true"><use href="#g-caveated"/></svg>{{ copy.verdict_caveated_name }}</span>
          <p class="verdict-claim">{{ copy.verdict_caveated_claim }}</p>
          <p class="verdict-detail">{{ copy.verdict_caveated_detail }}</p>
          <p class="verdict-refusal">{{ caveat }}</p>
        </article>

        <article class="verdict verdict--withheld">
          <span class="verdict-name"><svg class="glyph glyph--state" aria-hidden="true"><use href="#g-withheld"/></svg>{{ copy.verdict_withheld_name }}</span>
          <p class="verdict-claim">{{ copy.verdict_withheld_claim }}</p>
          <p class="verdict-detail">{{ copy.verdict_withheld_detail }}</p>
          <p class="verdict-refusal">{{ refusal }}</p>
        </article>
      </div>

      <p class="synthetic-note">{{ copy.verdicts_note }}</p>
    </div>
  </section>

  {# ══ Why Khepri ═════════════════════════════════════════════════════════════════════════ #}
  <section class="register register--deep" aria-labelledby="pillars-title">
    <div class="wall">
      <h2 class="register-mark" id="pillars-title"><span>{{ copy.pillars_heading }}</span></h2>

      <div class="pillars">
        <article class="pillar">
          <h3>{{ copy.pillar_1_name }}</h3>
          <p>{{ copy.pillar_1_body }}</p>
        </article>
        <article class="pillar">
          <h3>{{ copy.pillar_2_name }}</h3>
          <p>{{ copy.pillar_2_body }}</p>
        </article>
        <article class="pillar">
          <h3>{{ copy.pillar_3_name }}</h3>
          <p>{{ copy.pillar_3_body }}</p>
        </article>
        <article class="pillar">
          <h3>{{ copy.pillar_4_name }}</h3>
          <p>{{ copy.pillar_4_body }}</p>
        </article>
      </div>
    </div>
  </section>

  {# ══ The two scripts, as equal courses ══════════════════════════════════════════════════ #}
  <section class="register" aria-labelledby="scripts-title">
    <div class="wall">
      <h2 class="register-mark" id="scripts-title"><span>{{ copy.scripts_heading }}</span></h2>

      <div class="scripts">
        {# Both panels name the metric from the governed catalog, in their own script. A literal
           here would be a second maintained truth for a metric name (`FR-085`), and it would go
           stale silently — the specimen would follow a catalog rename and these would not. #}
        <div class="script-panel" lang="en" dir="ltr">
          <p class="script-name"><span>EN</span><span>English</span></p>
          <p class="script-claim">{{ panel_metric_en }}</p>
          <p class="script-figure tabular">4,182,600 EGP</p>
          <p class="script-note">Reconciled across 18 stores.</p>
        </div>

        <div class="script-panel" lang="ar" dir="rtl">
          <p class="script-name"><span>ع</span><span>العربية</span></p>
          <p class="script-claim">{{ panel_metric_ar }}</p>
          <p class="script-figure tabular">٤٬١٨٢٬٦٠٠ ج.م</p>
          <p class="script-note">تمت المطابقة عبر ١٨ متجرًا.</p>
        </div>
      </div>

      {# The strip. One figure, stated once in each script, with the sun disc between them — the
         two readings meet at the disc rather than one being a translation of the other. Beneath
         each, the four things established before the runtime will report a figure at all. #}
      <div class="strip">
        <div class="strip-side" lang="en" dir="ltr">
          <p class="strip-term">{{ panel_metric_en }}</p>
          <p class="strip-figure tabular">4,182,600 <span class="strip-unit">EGP</span></p>
          <dl class="strip-fields">
            {% for field in strip_fields_en %}
            <div><dt>{{ field.term }}</dt><dd>{{ field.value }}</dd></div>
            {% endfor %}
          </dl>
        </div>

        <div class="strip-disc" aria-hidden="true">
          <svg class="glyph glyph--disc" aria-hidden="true"><use href="#g-sun"/></svg>
        </div>

        <div class="strip-side" lang="ar" dir="rtl">
          <p class="strip-term">{{ panel_metric_ar }}</p>
          <p class="strip-figure tabular">٤٬١٨٢٬٦٠٠ <span class="strip-unit">ج.م</span></p>
          <dl class="strip-fields">
            {% for field in strip_fields_ar %}
            <div><dt>{{ field.term }}</dt><dd>{{ field.value }}</dd></div>
            {% endfor %}
          </dl>
        </div>
      </div>

      <p class="strip-note">{{ copy.strip_note }}</p>

      <p class="synthetic-note">{{ copy.scripts_note }}</p>
    </div>
  </section>

  {# ══ REGISTER VI — decision. No CTA: FR-087 permits one only where the destination
       already exists, and no active specification authorizes a public one. ═══════════════ #}
  <section class="register register--close" aria-labelledby="close-title">
    <div class="wall">
      <h2 class="close-headline" id="close-title">{{ copy.close_headline }}</h2>
      <p class="close-body">{{ copy.close_body }}</p>
    </div>
  </section>

</main>

<footer class="colophon">
  <div class="wall colophon-row">
    <nav aria-label="{{ copy.legal_navigation }}">
      <ul>
        {% for link in legal_links %}
        <li><a href="{{ link.href }}">{{ link.title }}</a></li>
        {% endfor %}
        <li><a href="{{ alternate_href }}" lang="{{ copy.language_code }}" hreflang="{{ copy.language_code }}" dir="auto">{{ copy.language }}</a></li>
      </ul>
    </nav>
    <span class="colophon-mark"><span class="brand-sun" aria-hidden="true"></span>{{ copy.product }}</span>
  </div>
</footer>

</body>
</html>
