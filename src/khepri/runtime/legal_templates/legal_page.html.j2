{% extends "legal.html.j2" %}
{% block title %}{{ page_title }} · {{ copy.product }}{% endblock %}
{% block content %}
<section class="document-card" aria-labelledby="page-title">
  <h1 id="page-title">{{ page_title }}</h1>
  {% if publication_content %}
  {% for paragraph in publication_content %}
  <p>{{ paragraph }}</p>
  {% endfor %}
  {% else %}
  <p class="lede">{{ copy.unpublished_title }}</p>
  <p>{{ copy.unpublished_intro }}</p>
  {% endif %}
</section>
{% endblock %}
