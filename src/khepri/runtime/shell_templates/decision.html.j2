{% extends "shell.html.j2" %}
{% block title %}{{ decision.title }} · {{ copy.product }}{% endblock %}
{% block content %}
{#
  RCA-008 FR-161: a claim is presented only where the reader can also reach
  whether it is allowed to be made, so a card's status, availability, reason and
  caveats sit in the same row as its value and never on a terminal page.

  Nothing here computes. Every value, population and status arrived selected in
  the read model, and every label and refusal message is the governed catalog's.
#}
<section class="document-card" aria-labelledby="page-title">
  <h1 id="page-title">{{ decision.title }}</h1>
  <p class="lede">{{ decision.lede }}</p>

  {#
    FR-170: the Period Comparison source is not reachable, and this says so
    rather than rendering an empty tab. The slice that makes the source
    reachable removes this, not the slice that shipped the surface.
  #}
  {% if view.comparison_unreachable %}
  <p class="decision-unreachable" role="note">{{ view.comparison_unreachable }}</p>
  {% endif %}

  {# FR-164: the governed message, never the bare cause code. #}
  {% if view.refusal %}
  <p class="decision-refusal" role="alert">{{ view.refusal }}</p>
  {% endif %}

  {# FR-165: the unavailable outcome is content-free; it says that, and no why. #}
  {% if view.unavailable %}
  <p class="decision-unavailable" role="note">{{ decision.unavailable }}</p>
  {% endif %}

  {#
    FR-163: an admitted projection that published nothing is a different finding
    from a refusal, and says so in its own words.
  #}
  {% if view.empty %}
  <p class="decision-empty" role="note">{{ decision.no_rows }}</p>
  {% endif %}

  {#
    FR-161: the caveats that qualify these figures, on the surface that carries
    them. Rendered once because a StatedCaveat names a section and not a metric.
  #}
  {% if view.caveats %}
  <ul class="decision-caveats" aria-label="{{ decision.caveats_label }}">
    {% for caveat in view.caveats %}
    <li class="decision-caveat">{{ caveat }}</li>
    {% endfor %}
  </ul>
  {% endif %}

  {#
    FR-162: a card exposes its lines "directly or through one action". The
    action is the <details> below -- a disclosure on this page and never an
    address, because FR-161 says availability, caveats and refusals are
    "reachable from the surface carrying the figure ... and are not deferred to
    a terminal page". `data-line` names each required line so the test asserts
    against the requirement's own list rather than against this markup.

    There is no comparison line. FR-162 requires one "only when compatible" and
    FR-170's source is not; the note above says so once, for the page.
  #}
  {% if view.cards %}
  <ul class="decision-cards">
    {% for card in view.cards %}
    <li class="decision-card" data-status="{{ card.status }}">
      <span class="decision-label" data-line="label">{{ card.label }}</span>
      <span class="decision-value" data-line="value">{{ card.value }}</span>
      <span class="decision-status" data-line="status">{{ card.status }}</span>
      <span class="decision-population" data-line="population">{{ card.population }}</span>
      {% if card.availability %}
      <span class="decision-availability">{{ card.availability }}</span>
      {% endif %}
      {% if card.reason %}
      <span class="decision-reason">{{ card.reason }}</span>
      {% endif %}
      <details class="decision-drawer">
        <summary class="decision-drawer-summary">{{ decision.evidence_label }}</summary>

        {# The definition half: RRA-011's catalog, which FR-159 admits as structure. #}
        <p class="decision-definition" data-line="definition">
          {{ decision.definition_label }}: {{ card.drawer.definition }}
        </p>
        <p class="decision-formula" data-line="formula">
          {{ decision.formula_label }}: {{ card.drawer.formula_version }}
        </p>
        <p class="decision-versions" data-line="versions">
          {{ decision.versions_label }}: {{ card.versions }}
        </p>
        <p class="decision-unit" data-line="unit">
          {{ decision.unit_label }}:
          {% if card.drawer.units %}{{ card.drawer.units | join(", ") }}
          {% else %}{{ decision.not_stated }}{% endif %}
        </p>

        {# FR-137: what actually applied, requested and definition-fixed alike. #}
        <p class="decision-filters" data-line="filters">
          {{ decision.filters_label }}:
          {% if view.filters %}{{ view.filters | join(", ") }}
          {% else %}{{ decision.no_filters }}{% endif %}
        </p>

        {# FR-166: the period is a source selector, so the run is the period. #}
        <p class="decision-period" data-line="period">{{ period }}</p>

        {# FR-162's caveat count. Counted for display; never for the status. #}
        <p class="decision-caveat-count" data-line="caveats">
          {{ decision.caveats_label }}: {{ card.caveat_count }}
        </p>

        {#
          The figure half. Three answers and not two: unavailable is FR-165's
          content-free miss, an empty entries tuple is this projection having
          cited nothing for this metric, and neither is a refusal.
        #}
        {% if card.drawer.unavailable %}
        <p class="decision-evidence-unavailable" data-line="evidence" role="note">
          {{ decision.evidence_unavailable }}
        </p>
        {% elif card.drawer.entries %}
        <ul class="decision-evidence" data-line="evidence">
          {% for entry in card.drawer.entries %}
          <li class="decision-entry">
            <span class="decision-citation">{{ entry.citation }}</span>
            {% if entry.precision is not none %}
            <span class="decision-precision">
              {{ decision.precision_label }}: {{ entry.precision }}
            </span>
            {% endif %}
            {% if entry.inputs %}
            <span class="decision-inputs">
              {{ decision.inputs_label }}: {{ entry.inputs | join(", ") }}
            </span>
            {% endif %}
            {% if entry.provenance %}
            <span class="decision-provenance">{{ decision.provenance_label }}</span>
            {% endif %}
            {#
              FR-140: "the record says there is none" is a statement, so it is
              rendered as one. Data on an admitted projection, never a refusal.
            #}
            {% for absence in entry.absences %}
            <span class="decision-absence">{{ absence }}</span>
            {% endfor %}
          </li>
          {% endfor %}
        </ul>
        {% else %}
        <p class="decision-evidence-absent" data-line="evidence" role="note">
          {{ decision.evidence_absent }}
        </p>
        {% endif %}
      </details>
    </li>
    {% endfor %}
  </ul>
  {% endif %}
</section>
{% endblock %}
