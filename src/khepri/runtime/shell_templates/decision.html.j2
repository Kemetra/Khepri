{% extends "shell.html.j2" %}
{% block title %}{{ decision.title }} · {{ copy.product }}{% endblock %}
{% block content %}
{#
  RCA-008 FR-161: a claim is presented only where the reader can also reach
  whether it is allowed to be made, so a card's status, availability, reason and
  caveats sit in the same row as its value and never on a terminal page.

  Nothing here computes. Every value, population and status arrived selected in
  the read model, and every label and refusal message is the governed catalog's.
#}
{% include "_decision_cards.html.j2" %}

{#
  FR-166: the controls, modelled as what they actually are. The period is a
  source selector -- a completed run, addressed as a path segment -- and only
  store, product and category are view filters, offered on the views that admit
  them. There is no period filter input, because no published view names one.

  A GET form, so the applied state is the address and nothing is retained
  (FR-169). That is also what makes the state survive the language switch: the
  switch is built from surface_path, which carries this query string.
#}
<section class="document-card decision-controls" aria-labelledby="controls-title">
  <h2 id="controls-title">{{ controls.copy.controls_label }}</h2>

  {#
    FR-137/FR-164: a parameter no published view admits is refused, not dropped.
    The governed wording, never a string this surface invents.
  #}
  {#
    `role="status"`, not `role="alert"`. Master specification §13 classes an
    analytical refusal as "**Governed, not error**", and `role="alert"` is an
    *assertive* live region -- the role the journey reserves for its **transport
    error** (`test_rra_journey_accessibility.py:64`), while the journey's own
    refusal is `role="status"` (`:67`, recorded by name in §F.3). Polite is the
    correct grammar for a result the reader is entitled to, and it aligns the two
    families' semantics without sharing a class, a token or a sheet, so `FR-201`
    is untouched.
  #}
  {% if unsupported %}
  <p class="decision-unsupported" role="status" data-control="unsupported">{{ unsupported }}</p>
  {% endif %}

  {# The source selector. Each option re-addresses this same surface. #}
  <nav class="decision-sources" aria-label="{{ controls.copy.period_label }}">
    <p class="decision-sources-hint">{{ controls.copy.period_hint }}</p>
    {% if controls.sources %}
    <ul class="decision-source-list">
      {% for option in controls.sources %}
      <li class="decision-source" data-source="{{ option.source_id }}"
          {% if option.selected %}data-selected="true"{% endif %}>
        <a href="{{ prefix }}/{{ language }}/{{ organization_id }}/decisions/{{ option.source_id }}"
           {% if option.selected %}aria-current="true"{% endif %}>{{ option.source_id }}</a>
        {% if option.completed_at %}
        <span class="decision-source-completed">{{ option.completed_at }}</span>
        {% endif %}
      </li>
      {% endfor %}
    </ul>
    {% else %}
    <p class="decision-no-sources" role="note">{{ controls.copy.no_sources }}</p>
    {% endif %}
  </nav>

  {# The three real filters, offered only where a view admits them. #}
  {% if controls.filters %}
  <form class="decision-filter-form" method="get" action="{{ prefix }}/{{ language }}{{ surface_path.split('?')[0] }}">
    <fieldset>
      <legend>{{ controls.copy.filters_label }}</legend>
      {% for control in controls.filters %}
      <label class="decision-filter" data-filter="{{ control.dimension }}">
        <span class="decision-filter-label">{{ control.label }}</span>
        <input type="text" name="{{ control.dimension }}"
               value="{{ control.value or '' }}"
               placeholder="{{ controls.copy.any_label }}">
      </label>
      {% endfor %}
      <button type="submit">{{ controls.copy.apply_label }}</button>
      {% if controls.applied %}
      <a class="decision-clear" href="{{ prefix }}/{{ language }}{{ surface_path.split('?')[0] }}">{{ controls.copy.clear_label }}</a>
      {% endif %}
    </fieldset>
  </form>
  {% endif %}
</section>

{#
  S-3, S-4, S-5a and S-5b. Four sections and not three: FR-165 makes Basket and
  Concentration independent reads, so one may be admitted while the other is
  unavailable and this page renders partial success rather than failing whole.

  Every row is named by its own view's published field order. That is FR-167
  holding through the render as well as the read: a row carrying exactly what
  its view published cannot carry a four-state availability, because no
  breakdown view publishes one.
#}
{% for section in sections %}
{% include "_decision_sections.html.j2" %}
{% endfor %}
{% endblock %}
