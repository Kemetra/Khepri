{#
  Shared breakdown markup -- see `_decision_cards.html.j2` for why this is one
  definition rather than two.
#}
<section class="document-card decision-section" data-section="{{ section.section }}"
         aria-labelledby="section-{{ section.section }}">
  <h2 id="section-{{ section.section }}">{{ section.heading }}</h2>

  {# FR-164: the governed message, never the bare cause code. #}
  {#
    `role="status"`, not `role="alert"`. Master specification §13 classes an
    analytical refusal as "**Governed, not error**", and `role="alert"` is an
    *assertive* live region -- the role the journey reserves for its **transport
    error** (`test_rra_journey_accessibility.py:64`), while the journey's own
    refusal is `role="status"` (`:67`, recorded by name in §F.3). Polite is the
    correct grammar for a result the reader is entitled to, and it aligns the two
    families' semantics without sharing a class, a token or a sheet, so `FR-201`
    is untouched.
  #}
  {% if section.refusal %}
  <p class="decision-refusal" role="status">{{ section.refusal }}</p>
  {% endif %}

  {# FR-165: content-free. This says a part is unavailable and never says why. #}
  {% if section.unavailable %}
  <p class="decision-unavailable" role="note">{{ decision.unavailable }}</p>
  {% endif %}

  {#
    FR-163: the two governed empty rules are different findings with different
    remedies, so they are different sentences. A store filter naming a store
    with no sales is not a refused measure.
  #}
  {% if section.empty %}
  <p class="decision-empty" role="note">{{ section.empty }}</p>
  {% endif %}

  {% if section.caveats %}
  <ul class="decision-caveats" aria-label="{{ decision.caveats_label }}">
    {% for caveat in section.caveats %}
    <li class="decision-caveat">{{ caveat }}</li>
    {% endfor %}
  </ul>
  {% endif %}

  {#
    FR-137/FR-161: this section's own applied request, from its own outcome.
    Filters are routed to the views whose definitions admit them, so two
    sections can stand over different populations and each states its own.
  #}
  <p class="decision-section-filters" data-line="filters">
    {{ decision.filters_label }}:
    {% if section.filters %}{{ section.filters | join(", ") }}
    {% else %}{{ decision.no_filters }}{% endif %}
  </p>

  {% if section.rows %}
  <ul class="decision-rows">
    {% for row in section.rows %}
    <li class="decision-row">
      {% if row.label %}
      <span class="decision-label">{{ row.label }}</span>
      {% endif %}
      {% for name, value in row.cells %}
      <span class="decision-cell" data-cell="{{ name }}">{{ value }}</span>
      {% endfor %}

      {# FR-161: this figure's claim and its limits, on the surface carrying it. #}
      <details class="decision-drawer">
        <summary class="decision-drawer-summary">{{ decision.evidence_label }}</summary>
        <p class="decision-definition">
          {{ decision.definition_label }}: {{ row.drawer.definition }}
        </p>
        <p class="decision-formula">
          {{ decision.formula_label }}: {{ row.drawer.formula_version }}
        </p>
        <p class="decision-unit">
          {{ decision.unit_label }}:
          {% if row.drawer.units %}{{ row.drawer.units | join(", ") }}
          {% else %}{{ decision.not_stated }}{% endif %}
        </p>
        <p class="decision-period">{{ period }}</p>
        {% if row.drawer.unavailable %}
        <p class="decision-evidence-unavailable" role="note">
          {{ decision.evidence_unavailable }}
        </p>
        {% elif row.drawer.entries %}
        <ul class="decision-evidence">
          {% for entry in row.drawer.entries %}
          <li class="decision-entry">
            <span class="decision-citation">{{ entry.citation }}</span>
            {% for absence in entry.absences %}
            <span class="decision-absence">{{ absence }}</span>
            {% endfor %}
          </li>
          {% endfor %}
        </ul>
        {% else %}
        <p class="decision-evidence-absent" role="note">{{ decision.evidence_absent }}</p>
        {% endif %}
      </details>
    </li>
    {% endfor %}
  </ul>
  {% endif %}
</section>
