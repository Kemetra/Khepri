{% extends "shell.html.j2" %}
{% block title %}{{ copy.team_title }} · {{ copy.product }}{% endblock %}
{% block content %}
{#
  `RCA-002` FR-051. The members shown are whatever the organization-scoped read returned; this
  template filters nothing. A filter here would be a second place the scope is decided, and the
  rows it removed would be other organizations' people.

  A disabled member is shown and labelled rather than hidden. Hiding them would make the list
  disagree with the organization's actual membership, and an owner cannot act on a person they
  cannot see. Disablement never touches `rca_memberships`, so the label is the only thing that
  distinguishes them.
#}
<section class="document-card" aria-labelledby="page-title">
  <h1 id="page-title">{{ copy.team_title }}</h1>
  <p class="lede">{{ copy.team_intro }}</p>
  {% if members %}
  <ul class="member-list">
    {% for member in members %}
    <li class="member-item{% if member.disabled %} member-item--disabled{% endif %}">
      <span class="member-identity" dir="ltr">{{ member.email }}</span>
      <span class="member-role">
        {%- if member.role == "owner" %}{{ copy.role_owner }}{% else %}{{ copy.role_member }}{% endif -%}
      </span>
      {% if member.disabled %}<span class="member-state">{{ copy.member_disabled }}</span>{% endif %}
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <p class="empty-state">{{ copy.team_empty }}</p>
  {% endif %}
</section>

{% if is_owner and invitations_available %}
<section class="document-card" aria-labelledby="invite-title">
  {#
    The route this posts to shipped in `R8-05b` with no form to reach it, so an owner could withdraw
    an invitation and never create one. It is gated on `is_owner` for the same reason the withdraw
    button is: `require_owner` refuses a member at the gate, and rendering the control anyway would
    offer an action whose only outcome is the indistinguishable refusal `FR-052` forbids explaining.

    Gated on the gateway as well as on the role. `ShellServices.invitations` is optional and a shell
    configured without one still renders this surface, where every submission is refused -- so
    ownership alone would put an enabled form in front of an owner who cannot use it, and it would
    answer like a fault rather than like a capability nobody installed.

    The field names are the two `issue_invitation` reads from the body, and the options are exactly
    `ROLES`. `member` is preselected rather than left empty: an unselected role posts a value the
    allowlist refuses, which reaches the reader as "this page is unavailable" with no cause it may
    disclose -- a dead end built out of a placeholder.
  #}
  <h2 id="invite-title">{{ copy.invite_title }}</h2>
  <p class="lede">{{ copy.invite_intro }}</p>
  <form method="post" action="{{ prefix }}/{{ language }}/{{ organization_id }}/team/invitations">
    <p>
      <label for="invite-email">{{ copy.invite_email_label }}</label>
      <input id="invite-email" name="email" type="email" dir="ltr" autocomplete="email" required>
    </p>
    <p>
      <label for="invite-role">{{ copy.invite_role_label }}</label>
      <select id="invite-role" name="role">
        <option value="member" selected>{{ copy.role_member }}</option>
        <option value="owner">{{ copy.role_owner }}</option>
      </select>
    </p>
    <button type="submit">{{ copy.invite_submit }}</button>
  </form>
</section>
{% endif %}

<section class="document-card" aria-labelledby="invitations-title">
  <h2 id="invitations-title">{{ copy.invitations_title }}</h2>
  {#
    No token is rendered here and none could be: `issue` returns the secret once and only a salted
    hash persists. The list shows who was invited and in what role, which is what an owner needs to
    decide whether to revoke.
  #}
  {% if invitations %}
  <ul class="invitation-list">
    {% for invitation in invitations %}
    <li class="invitation-item">
      <span class="invitation-identity" dir="ltr">{{ invitation.target_identity }}</span>
      <span class="invitation-role">
        {%- if invitation.intended_role == "owner" %}{{ copy.role_owner }}{% else %}{{ copy.role_member }}{% endif -%}
      </span>
      {% if is_owner %}
      <form method="post"
            action="{{ prefix }}/{{ language }}/{{ organization_id }}/team/invitations/{{ invitation.invitation_id }}/revoke">
        <button type="submit">{{ copy.invitation_revoke }}</button>
      </form>
      {% endif %}
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <p class="empty-state">{{ copy.invitations_empty }}</p>
  {% endif %}
</section>
{% endblock %}
